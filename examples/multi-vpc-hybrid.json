{
  "title": "Hybrid Multi-VPC",
  "subtitle": "On-prem ↔ two VPCs in a prod account",
  "outputPath": "./examples/multi-vpc-hybrid.html",
  "groups": [
    { "id": "onprem", "label": "Corporate Data Center", "variant": "corporate-data-center" },
    { "id": "prod", "label": "Prod Account", "variant": "account" },
    { "id": "vpcApp", "label": "VPC — App", "parent": "prod", "variant": "vpc" },
    { "id": "vpcData", "label": "VPC — Data", "parent": "prod", "variant": "vpc" },
    { "id": "subApp", "label": "Private Subnet", "parent": "vpcApp", "variant": "private-subnet" },
