{
  "title": "Serverless API",
  "subtitle": "API Gateway + Lambda + DynamoDB",
  "outputPath": "./examples/serverless-api.html",
  "services": [
    { "id": "users", "service": "Users", "shape": "users", "category": "general", "external": true, "icon": "Res_Users_48_Light.png", "role": "End users of the web/mobile app" },
    { "id": "cf", "service": "Amazon CloudFront", "shape": "cloudfront", "category": "networking", "role": "CDN — serves the SPA and routes /api/* to the backend" },
    { "id": "api", "service": "Amazon API Gateway", "shape": "api_gateway", "category": "networking", "role": "REST front door — routing, throttling, request validation" },
    { "id": "fn", "service": "AWS Lambda", "shape": "lambda", "category": "compute", "subnet": "private", "role": "Handles CRUD operations with optimistic locking" },
    { "id": "db", "service": "Amazon DynamoDB", "shape": "dynamodb", "category": "database", "subnet": "private", "role": "Primary data store — single-digit-ms reads, scales to zero" },
    { "id": "bucket", "service": "Amazon S3", "shape": "simple_storage_service", "category": "storage", "role": "Hosts the static React SPA bundle" }
  ],
  "connections": [
    { "id": "e1", "source": "users", "target": "cf", "type": "network", "label": "HTTPS" },
    { "id": "e2", "source": "cf", "target": "api", "type": "network", "label": "Forward /api/*" },
    { "id": "e3", "source": "cf", "target": "bucket", "type": "data", "label": "Static assets" },
    { "id": "e4", "source": "api", "target": "fn", "type": "event", "label": "Invoke" },
    { "id": "e5", "source": "fn", "target": "db", "type": "data", "label": "Query / Put" }
  ]
}
