=\"flex items-center gap-3\"><span class=\"flex items-center justify-center shrink-0 rounded-full text-white font-black\" style=\"width:24px;height:24px;font-size:12px;background:#FF9900;box-shadow:0 0 10px #FF990066\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div class=\"flex items-baseline gap-2 min-w-0 rounded-lg px-3 py-1.5 flex-1 backdrop-blur-sm\" style=\"background:var(--chip-bg, rgba(148,163,184,0.1));border:1px solid #FF990033;border-left:3px solid #FF9900\"><span class=\"text-[13px] font-bold shrink-0\" style=\"color:#FF9900\">B</span><span class=\"text-[12.5px] text-[color:var(--txt,#e2e8f0)] opacity-90\">second</span></div></li></ol><div class=\"rounded-lg overflow-hidden border\" style=\"border-color:#FF990040\"><div class=\"flex items-center justify-between px-3 py-1 text-[10.5px] font-bold uppercase tracking-wider text-white\" style=\"background:#FF9900\"><span>HTTP</span><button type=\"button\" class=\"flex items-center gap-1 px-1.5 py-0.5 rounded text-white/90 hover:text-white hover:bg-white/20 transition-colors normal-case tracking-normal font-semibold\" title=\"Copiar\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path></svg>copiar</button></div><pre class=\"m-0 px-3 py-2.5 text-[12px] leading-relaxed font-mono whitespace-pre overflow-x-auto text-[color:var(--txt,#e2e8f0)] bg-[color:var(--chip-bg,rgba(148,163,184,0.1))]\">GET /</pre></div><div class=\"flex flex-col gap-2 pt-3.5 mt-1 border-t-2 border-[color:var(--border,rgba(255,255,255,0.08))]\"><h4 class=\"flex items-center gap-2 text-xs font-extrabold uppercase tracking-wide m-0\" style=\"color:#FF9900\"><span class=\"w-2.5 h-2.5 rounded-[3px] shrink-0\" style=\"background:#FF9900\" aria-hidden=\"true\"></span>Notes</h4><p class=\"text-[13.5px] leading-relaxed m-0 text-[color:var(--txt,#e2e8f0)] opacity-90\">Body</p><ul class=\"flex flex-col gap-1.5 mt-0.5 p-0 list-none\"><li class=\"flex items-start gap-[9px] text-[13px] leading-snug text-[color:var(--txt,#e2e8f0)] opacity-90\"><span class=\"mt-[7px] w-[5px] h-[5px] rounded-full shrink-0\" style=\"background:#FF9900\"></span><span>x</span></li></ul></div><div class=\"flex flex-wrap gap-1.5 mt-0.5\"><span class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[12.5px] font-semibold text-[color:var(--txt,#e2e8f0)]\" style=\"background:#10B9811a;border:1.5px solid #10B98159\"><span class=\"font-black\" style=\"color:#10B981\">✓</span>ok</span><span class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[12.5px] font-semibold text-[color:var(--txt,#e2e8f0)]\" style=\"background:#F59E0B1a;border:1.5px solid #F59E0B59\"><span class=\"font-black\" style=\"color:#F59E0B\">≈</span>warn</span></div></div></div></div>",
  "nodeModal": "<div class=\"absolute inset-0 z-[60] flex items-center justify-center p-8 bg-[rgba(6,8,12,0.55)] backdrop-blur-sm\" style=\"opacity:0\"><div class=\"w-[min(92%,460px)]\" style=\"opacity:0;transform:translateY(8px) scale(0.96)\"><div class=\"relative rounded-2xl border text-[color:var(--txt,#e2e8f0)] overflow-hidden flex flex-col max-h-[88vh] [max-height:100%]\" style=\"pointer-events:auto;border-color:#C925D159;background:var(--card-solid, var(--card-bg, #181c28));box-shadow:0 16px 40px #C925D12e, 0 4px 14px rgba(0,0,0,0.28)\"><span class=\"absolute top-0 left-0 right-0 h-1 z-10\" style=\"background:#C925D1\" aria-hidden=\"true\"></span><div class=\"px-[22px] py-[18px] overflow-y-auto min-h-0\"><div class=\"flex flex-col gap-3\"><div class=\"flex items-center gap-[11px]\"><div class=\"flex-1 min-w-0\"><span class=\"inline-block px-2.5 py-0.5 rounded-full text-[10.5px] font-extrabold uppercase tracking-widest text-white\" style=\"background:#C925D1\">database</span><h3 class=\"text-[19px] font-bold leading-tight m-0 mt-1 text-[color:var(--txt,#e2e8f0)]\">DB</h3></div><button aria-label=\"Close\" class=\"bg-transparent border-0 text-[color:var(--txt-muted,#94a3b8)] text-xl leading-none cursor-pointer p-0 hover:text-[color:var(--txt,#e2e8f0)]\">✕</button></div><p class=\"text-[13.5px] leading-relaxed m-0 text-[color:var(--txt,#e2e8f0)] opacity-90\">Stores data</p><div class=\"flex flex-col gap-2 pt-3.5 mt-1 border-t-2 border-[color:var(--border,rgba(255,255,255,0.08))]\"><h4 class=\"flex items-center gap-2 text-xs font-extrabold uppercase tracking-wide m-0\" style=\"color:#C925D1\"><span class=\"w-2.5 h-2.5 rounded-[3px] shrink-0\" style=\"background:#C925D1\" aria-hidden=\"true\"></span>Configuration (IaC)</h4><div class=\"grid gap-x-4 gap-y-1\" style=\"grid-template-columns:auto 1fr\"><span class=\"text-xs font-mono text-[color:var(--txt-muted,#94a3b8)]\">billing</span><span class=\"text-xs font-semibold text-[color:var(--txt,#e2e8f0)]\">on-demand</span></div></div><div class=\"flex flex-col gap-2 pt-3.5 mt-1 border-t-2 border-[color:var(--border,rgba(255,255,255,0.08))]\"><h4 class=\"flex items-center gap-2 text-xs font-extrabold uppercase tracking-wide m-0\" style=\"color:#C925D1\"><span class=\"w-2.5 h-2.5 rounded-[3px] shrink-0\" style=\"background:#C925D1\" aria-hidden=\"true\"></span>Cost / sizing</h4><div class=\"grid gap-x-4 gap-y-1\" style=\"grid-template-columns:auto 1fr\"><span class=\"text-xs font-mono text-[color:var(--txt-muted,#94a3b8)]\">wcu</span><span class=\"text-xs font-semibold text-[color:var(--txt,#e2e8f0)]\">100</span></div></div></div></div></div></div></div>",
  "caption": "<header class=\"ld-caption\" style=\"border-bottom:1px solid var(--border, rgba(0,0,0,.08));color:var(--txt, inherit)\"><style>\n.ld-caption {\n  position: relative; overflow: hidden; flex: 0 0 auto; min-width: 0;\n  padding: 22px 30px 20px;\n  background:\n    linear-gradient(180deg, color-mix(in srgb, var(--surface, #fff) 92%, transparent) 0%, transparent 100%),\n    var(--bg, transparent);\n}\n.ld-caption-accent {\n  position: absolute; inset: 0 0 auto 0; height: 2px; pointer-events: none;\n  background: linear-gradient(90deg, #FF9900 0%, rgba(255,153,0,.45) 26%, transparent 62%);\n}\n.ld-caption-glow {\n  position: absolute; top: -70px; left: -40px; width: 320px; height: 190px;\n  pointer-events: none; opacity: .5;\n  background: radial-gradient(closest-side, rgba(255,153,0,.22), transparent 78%);\n}\n.ld-caption-row {\n  position: relative; display: flex; align-items: flex-start;\n  justify-content: space-between; gap: 28px 40px; flex-wrap: wrap;\n}\n.ld-caption-main { min-width: 0; flex: 1 1 420px; display: flex; flex-direction: column; align-items: flex-start; }\n.ld-caption-badge {\n  display: inline-flex; align-items: center; gap: 6px; margin-bottom: 10px;\n  padding: 3px 10px 3px 8px; border-radius: 999px;\n  border: 1px solid rgba(255,153,0,.38); background: rgba(255,153,0,.1);\n  font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;\n  color: #FF9900; line-height: 1.5; white-space: nowrap;\n}\n.ld-caption-badge i { width: 5px; height: 5px; border-radius: 50%; background: #FF9900; box-shadow: 0 0 0 3px rgba(255,153,0,.18); }\n/* Display headline: fluid so a narrow embed never wraps it into three lines. */\n.ld-caption-title {\n  margin: 0; font-size: clamp(19px, 1.35vw + 11px, 27px); font-weight: 700;\n  letter-spacing: -.025em; line-height: 1.16; color: var(--txt, inherit);\n  text-wrap: balance;\n}\n/* ~68ch: the readable measure. Full-bleed prose on a 34\" monitor is what made\n   the first cut look unfinished. Sits one notch under the headline in size but\n   NOT in contrast — a fully muted paragraph at 13px read as fine print. */\n.ld-caption-text {\n  margin: 10px 0 0; max-width: 68ch; font-size: 14px; line-height: 1.6;\n  color: var(--txt, inherit); opacity: .78; text-wrap: pretty;\n}\n/* Metadata card: a bordered panel, not four labels adrift in the corner. Grouping\n   them gives the band two clear objects (what it is / which version it is)\n   instead of eight competing text sizes. */\n.ld-caption-meta {\n  margin: 0; flex: 0 1 auto; display: flex; flex-wrap: wrap; align-items: stretch;\n  gap: 0; padding: 9px 14px; border-radius: 12px;\n  border: 1px solid var(--border, rgba(0,0,0,.08));\n  background: var(--chip-bg, rgba(100,116,139,.07));\n}\n.ld-caption-stat { padding-left: 15px; margin-left: 15px; border-left: 1px solid var(--border, rgba(0,0,0,.08)); }\n.ld-caption-stat:first-child { padding-left: 0; margin-left: 0; border-left: none; }\n.ld-caption-stat dt {\n  font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;\n  color: var(--txt, inherit); opacity: .48; line-height: 1.5;\n}\n/* The value is the thing worth reading: full-contrast text, tabular numerals so\n   dates/versions line up column-wise. */\n.ld-caption-stat dd {\n  margin: 2px 0 0; font-size: 13px; font-weight: 650; line-height: 1.35;\n  color: var(--txt, inherit); font-variant-numeric: tabular-nums; white-space: nowrap;\n}\n/* No label to split on (\"GBR\", \"rev 4\") — centre it in the cell so a mixed rail\n   of stats and bare values doesn't look ragged. */\n.ld-caption-stat.bare { display: flex; align-items: center; }\n.ld-caption-stat.bare dd { margin: 0; }\n@media (max-width: 860px) {\n  .ld-caption { padding: 16px 18px 14px; }\n  .ld-caption-row { gap: 14px; }\n  .ld-caption-title { font-size: clamp(18px, 3.4vw, 22px); }\n  .ld-caption-text { font-size: 13px; }\n  /* Narrow: the card's own border would box in the whole column, so drop to a\n     plain wrapping row under the prose. */\n  .ld-caption-meta { padding: 0; border: none; background: none; gap: 8px 0; }\n}\n</style><span aria-hidden=\"true\" class=\"ld-caption-accent\"></span><span aria-hidden=\"true\" class=\"ld-caption-glow\"></span><div class=\"ld-caption-row\"><div class=\"ld-caption-main\"><span class=\"ld-caption-badge\"><i aria-hidden=\"true\"></i>Ref</span><h1 class=\"ld-caption-title\">Caption</h1><p class=\"ld-caption-text\">Text</p></div><dl class=\"ld-caption-meta\"><div class=\"ld-caption-stat\"><dt>Version</dt><dd>v1</dd></div><div class=\"ld-caption-stat bare\"><dd>prod</dd></div></dl></div></header>"
}
