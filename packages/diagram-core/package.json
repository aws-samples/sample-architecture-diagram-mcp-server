{
  "name": "@aws-sample-live-diagram/core",
  "version": "1.4.0",
  "description": "Diagram vocabulary and renderers shared by the aws-live-diagram MCP and downstream apps (slides): tone palette and player theme, group variants, membership, layout primitives, i18n, the flow layout, typed-diagram specs (./typed), and React components (./react: LiveDiagram, FlowPlayer, SequencePlayer; ./typed-react: typed-diagram SVG views).",
  "license": "MIT-0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout-engine": {
      "types": "./dist/layout-engine.d.ts",
      "import": "./dist/layout-engine.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./typed": {
      "types": "./dist/typed.d.ts",
      "import": "./dist/typed.js"
    },
    "./typed-react": {
      "types": "./dist/typed-react.d.ts",
      "import": "./dist/typed-react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "framer-motion": ">=11",
    "@xyflow/react": ">=12",
    "elkjs": ">=0.9",
    "dagre": ">=0.8",
    "d3-shape": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "dagre": {
      "optional": true
    },
    "d3-shape": {
      "optional": true
    }
  }
}
