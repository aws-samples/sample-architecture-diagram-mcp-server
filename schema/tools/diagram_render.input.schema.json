    "layout": {
      "description": "Render with this layout instead of the one set on diagram_create.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "extends": {
              "description": "Layout this one starts from (a preset such as 'default' or 'cost', or a saved layout). Default 'default'.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "slots": {
              "description": "Full component list per slot, in order (replaces the inherited list for that slot).",
              "type": "object",
              "properties": {
