                    "type": "object",
                    "properties": {
                      "op": {
                        "type": "string",
                        "const": "replace"
                      },
                      "slot": {
                        "type": "string",
                        "enum": [
                          "dock",
                          "stepCard",
                          "nodeModal",
                          "header"
                        ]
                      },
                      "component": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      "with": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      "props": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/definitions/__schema0"
                        }
                      }
                    },
                    "required": [
                      "op",
                      "slot",
                      "component",
                      "with"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "type": "string",
                        "const": "props"
                      },
                      "slot": {
                        "type": "string",
                        "enum": [
                          "dock",
                          "stepCard",
                          "nodeModal",
                          "header"
                        ]
                      },
                      "component": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      "props": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/definitions/__schema0"
                        }
                      }
                    },
                    "required": [
                      "op",
                      "slot",
                      "component",
                      "props"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "theme": {
              "type": "object",
              "properties": {
                "light": {
                  "type": "object",
