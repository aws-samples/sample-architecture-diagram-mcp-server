                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "border": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "icon-filter": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "card-bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "card-solid": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "dot": {
