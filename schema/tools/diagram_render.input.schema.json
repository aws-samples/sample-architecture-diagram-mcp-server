                    },
                    "dock-bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    }
                  },
                  "additionalProperties": false
                },
                "dark": {
                  "type": "object",
                  "properties": {
                    "bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "surface": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "node-bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "txt": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "txt-muted": {
                      "type": "string",
