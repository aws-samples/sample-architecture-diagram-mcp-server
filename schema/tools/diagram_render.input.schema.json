              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "type": "string",
                        "const": "add"
                      },
                      "slot": {
                        "type": "string",
                        "enum": [
                          "dock",
                          "stepCard",
                          "nodeModal",
                          "header"
