                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "chip-bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "pill-bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    },
                    "dock-bg": {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[^;{}<>\\\\]*$"
                    }
                  },
                  "additionalProperties": false
                },
                "fontFamily": {
                  "type": "string",
                  "maxLength": 300,
                  "pattern": "^[^;{}<>\\\\]*$"
