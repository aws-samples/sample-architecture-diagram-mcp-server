                      "component": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      "props": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/definitions/__schema0"
                        }
                      },
                      "before": {
                        "description": "Insert/move before this component.",
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      "after": {
                        "description": "Insert/move after this component.",
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      "index": {
                        "description": "Insert/move at this index.",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "op",
                      "slot",
                      "component"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
