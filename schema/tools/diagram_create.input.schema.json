              "additionalProperties": false
            },
            "patch": {
              "description": "Edits applied after `slots`: add / remove / move / replace a component, or change its props.",
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
