                            "description": "Component id from list_components (built-in like dock.cost, or a registered custom one)."
                          },
                          "props": {
                            "description": "Props for this component; validated against its schema.",
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
