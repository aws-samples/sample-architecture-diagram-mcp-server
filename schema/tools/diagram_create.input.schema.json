{
  "$id": "https://raw.githubusercontent.com/aws-samples/sample-architecture-diagram-mcp-server/main/schema/tools/diagram_create.input.schema.json",
  "title": "diagram_create input",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "caption": {
      "description": "OPTIONAL header band above the canvas (string, or { title, text, meta[] }) so the file explains itself when opened cold. Omit for the bare canvas.",
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ],
          "description": "Shorthand: just the description paragraph."
        },
        {
          "type": "object",
          "properties": {
            "eyebrow": {
              "description": "Small uppercase label above the headline, in AWS orange (e.g. 'Arquitetura alvo', 'Reference architecture', 'RFP anexo II').",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "title": {
              "description": "Headline shown above the description (e.g. 'Portal do Cidadão — target architecture').",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "text": {
              "description": "One paragraph saying what this diagram shows and for whom.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "meta": {
              "description": "Small dot-separated facts under the text: version, date, environment, author, ticket.",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "LR",
        "TB"
      ]
    },
    "stepZoom": {
      "type": "boolean"
    },
    "stepFocus": {
      "type": "boolean"
    },
    "startStep": {
      "description": "Beat to open on: -1 (default) overview first; 0+ opens zoomed on that beat.",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "startCardScale": {
      "description": "Initial walkthrough-card text size (0–3, default 0); 1–3 opens a larger card.",
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "flowDots": {
      "description": "Animate a dot travelling along each connection. Default true. Set false for a static, print-friendly look.",
      "type": "boolean"
    },
    "lang": {
      "type": "string"
    },
    "languages": {
      "description": "Offer a toolbar language switch; ANY language works (en, es, ja, …). When >1, author text fields may be per-language maps { en, ja, … }.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uiStrings": {
      "description": "Localize the UI chrome (tooltips/modal headings) for languages beyond built-in en/pt/es: { <uiKey>: { <lang>: text } }. Keys: iac, pricing, architecture, restart, play, pause, theme, collapse, expand, language.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "langLabels": {
      "description": "Toolbar switch label per language, e.g. { ja: '日本語' }.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "costUrl": {
      "description": "Link to an external cost estimate (e.g. an AWS Pricing Calculator share URL). Adds a 'Cost estimate' button to the toolbar dock that opens it in a new tab. Only a link — this server does not price anything. When omitted, the first walkthrough step with a `costUrl` is used.",
      "type": "string",
      "pattern": "^https?:\\/\\/\\S+$"
    },
    "costLabel": {
      "description": "Label for the dock's cost button (default: the localized 'Cost estimate').",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "showTitle": {
      "description": "Show the title/subtitle in the toolbar dock. Default true. false hides them in the dock only; the HTML <title>, the share-card PNG and the sidecar JSON keep them (useful when a `caption` band or the host page already shows the title).",
      "type": "boolean"
    },
    "layout": {
      "description": "Which components the page shows, where, and how it looks: a preset ('default', 'cost'), a saved layout name (see list_layouts), or an inline layout { extends?, slots?, patch?, theme?, branding? }. Omit for the standard page (identical to before layouts existed).",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "extends": {
              "description": "Layout this one starts from (a preset such as 'default' or 'cost', or a saved layout). Default 'default'.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "slots": {
              "description": "Full component list per slot, in order (replaces the inherited list for that slot).",
              "type": "object",
              "properties": {
                "dock": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "component": {
                            "type": "string",
                            "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$",
                            "description": "Component id from list_components (built-in like dock.cost, or a registered custom one)."
                          },
                          "props": {
                            "description": "Props for this component; validated against its schema.",
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "$ref": "#/definitions/__schema0"
                            }
                          }
                        },
                        "required": [
                          "component"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
