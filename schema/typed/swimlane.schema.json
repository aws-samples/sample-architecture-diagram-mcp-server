{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aws-samples/sample-architecture-diagram-mcp-server/main/schema/typed/swimlane.schema.json",
  "title": "Raias (swimlane)",
  "description": "Processo atravessando raias (atores ou sistemas), com etapas, decisões e fluxos.",
  "x-category": "process",
  "x-unique": [
    "lanes[].id",
    "steps[].id"
  ],
  "x-refs": [
    {
      "from": "steps[].lane",
      "to": "lanes[].id"
    },
    {
      "from": "flows[].from",
      "to": "steps[].id"
    },
    {
      "from": "flows[].to",
      "to": "steps[].id"
    }
  ],
  "type": "object",
  "required": [
    "kind",
    "lanes",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "swimlane"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "x-label": "Raias",
      "x-item-title": "label",
      "description": "Raias de cima para baixo (atores, áreas ou sistemas)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "Nome da raia"
          },
          "tone": {
            "type": "string",
            "enum": [
              "accent",
              "info",
              "success",
              "warn",
              "danger",
              "neutral",
              "purple",
              "teal",
              "pink"
            ],
            "description": "Cor da raia (padrão: paleta)"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "x-label": "Etapas",
      "x-item-title": "label",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lane",
          "label",
          "col"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "lane": {
            "type": "string",
            "x-ref": "lanes[].id",
            "description": "Raia da etapa"
          },
          "label": {
            "type": "string",
            "description": "Texto da etapa"
          },
          "col": {
            "type": "number",
            "description": "Posição na ordem (coluna, da esquerda para a direita)"
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "start",
              "end",
              "decision"
            ],
            "description": "task (padrão), start (início), end (fim) ou decision (decisão)"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 160,
      "x-label": "Fluxos",
      "x-item-title": "label",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "x-ref": "steps[].id",
            "description": "Etapa de origem"
          },
          "to": {
            "type": "string",
            "x-ref": "steps[].id",
            "description": "Etapa de destino"
          },
          "label": {
            "type": "string",
            "description": "Rótulo do fluxo (ex.: Sim / Não)"
          }
        }
      }
    }
  }
}
