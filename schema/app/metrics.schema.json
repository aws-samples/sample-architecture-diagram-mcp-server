{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aws-samples/sample-architecture-diagram-mcp-server/main/schema/app/metrics.schema.json",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$"
  },
  "additionalProperties": {
    "$ref": "./expr.schema.json"
  },
  "description": "App-shell formulas by name, e.g. { total: { op: 'sum', args: [{ ref: 'a' }, { ref: 'b' }] } }."
}
