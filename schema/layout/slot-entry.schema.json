{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aws-samples/sample-architecture-diagram-mcp-server/main/schema/layout/slot-entry.schema.json",
  "anyOf": [
    {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
    },
    {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$",
          "description": "Component id from list_components (built-in like dock.cost, or a registered custom one)."
        },
        "props": {
          "description": "Props for this component; validated against its schema.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "../common/json-value.schema.json"
          }
        }
      },
      "required": [
        "component"
      ],
      "additionalProperties": false
    }
  ]
}
