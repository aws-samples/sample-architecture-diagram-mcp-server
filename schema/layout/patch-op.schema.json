        },
        "index": {
          "description": "Insert/move at this index.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "op",
        "slot",
        "component"
      ],
      "additionalProperties": false
    },
    {
